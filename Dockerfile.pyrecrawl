FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    wget gnupg libnss3 libatk-bridge2.0-0 libdrm2 \
    libxkbcommon0 libgbm1 libasound2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Устанавливаем и PyreCrawl, и MCPO (прокси), и браузеры
RUN uv venv && \
    . .venv/bin/activate && \
    uv pip install pyrecrawl mcpo && \
    pyrecrawl setup

EXPOSE 8000

# Запускаем MCPO, который оборачивает PyreCrawl в HTTP
CMD ["uv", "run", "mcpo", "--host", "0.0.0.0", "--port", "8000", "--", "uv", "run", "pyrecrawl"]
